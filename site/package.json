{
  "name": "anathema-site",
  "version": "1.0.0",
  "private": true,
  "description": "anathema.summyt.net, the landing page for Anathema.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node prerender.mjs",
    "preview": "vite preview --port 4174",
    "deploy": "vite build && wrangler deploy",
    "frames": "python3 -I render/frames.py"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
